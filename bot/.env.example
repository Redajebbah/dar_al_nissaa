# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram (create a new bot → /newbot)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Your personal Telegram chat ID
# Send any message to @userinfobot on Telegram to get your ID
ADMIN_TELEGRAM_CHAT_ID=123456789

# ─── Site connection ──────────────────────────────────────────────────────────
# URL of the running Next.js site
SITE_URL=http://localhost:3000

# Must match ADMIN_SECRET in the site's .env.local
ADMIN_SECRET=change-this-to-a-random-secret

# ─── Claude AI ────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
